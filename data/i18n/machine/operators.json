  "char_4215_buddy.itemUsage": {
    "text": "Rhodes Island Infiltration Squad, Masamune and Yoshitsune, are currently planning a new investigation route.",
    "source": "machine"
  },
  "char_4215_buddy.itemDesc": {
    "text": "They would be very happy if you went for a walk with them.",
    "source": "machine"
  },
  "char_4217_makoto.potential.2.desc": {
    "text": "ATK +34",
    "source": "machine"
  },
  "char_4217_makoto.itemUsage": {
    "text": "S.E.E.S. Leader Makoto Yuki came face-to-face with another self on a full moon night.",
    "source": "machine"
  },
  "char_4217_makoto.itemDesc": {
    "text": "Pull the trigger, release the Persona from within the heart, and let blazing flames guide foes to annihilation.",
    "source": "machine"
  },
  "char_4218_aigis.itemUsage": {
    "text": "Walking across the campus, S.E.E.S. member Aigis resembles any ordinary girl.",
    "source": "machine"
  },
  "char_4218_aigis.itemDesc": {
    "text": "Toward what distant horizon will she journey?",
    "source": "machine"
  },
  "char_4219_yukari.potential.3.desc": {
    "text": "Redeployment Time -6s",
    "source": "machine"
  },
  "char_4219_yukari.itemUsage": {
    "text": "S.E.E.S. member Yukari Takeba has a cheerful demeanor and vibrant grace.",
    "source": "machine"
  },
  "char_4219_yukari.itemDesc": {
    "text": "Her popularity is plain for all to see, yet there is also a part of her that remains hard to approach.",
    "source": "machine"
  },
  "char_4220_kormr.itemUsage": {
    "text": "S.E.E.S. member Koromaru awaits your return.",
    "source": "machine"
  },
  "char_4220_kormr.itemDesc": {
    "text": "Don't keep him waiting too long.",
    "source": "machine"
  },
  "char_4229_aphris.potential.2.desc": {
    "text": "ATK +35",
    "source": "machine"
  },
  "char_4231_clemnt.potential.2.desc": {
    "text": "ATK +35",
    "source": "machine"
  },
  "char_4229_aphris.itemUsage": {
    "text": "Caster Operator Muyn claims to be an ordinary Originium technology researcher.",
    "source": "machine"
  },
  "char_4229_aphris.itemDesc": {
    "text": "You may certainly try trusting her, but there is no need to trust her dossier.",
    "source": "machine"
  },
  "char_4230_mcnist.potential.2.desc": {
    "text": "DEF +28",
    "source": "machine"
  },
  "char_4230_mcnist.itemUsage": {
    "text": "Defender Operator Mechanic has been integrated into your command structure effective immediately.",
    "source": "machine"
  },
  "char_4230_mcnist.itemDesc": {
    "text": "In truth, however, you have long since been written into his chain of command. After all, countless devices you have used were created by him—and remain under his control.",
    "source": "machine"
  },
  "char_4231_clemnt.itemUsage": {
    "text": "Aegir native Clemenceau, pleased to meet you.",
    "source": "machine"
  },
  "char_4231_clemnt.itemDesc": {
    "text": "Depending on context, \"pleased\" can refer to the profound significance of sea-land cooperation, or it can genuinely just mean \"pleased.\"",
    "source": "machine"
  },
  "char_4232_hbound.potential.1.desc": {
    "text": "Redeployment Time -10s",
    "source": "machine"
  },
  "char_4236_tmslot.potential.1.desc": {
    "text": "Redeployment Time -10s",
    "source": "machine"
  },
  "char_4232_hbound.itemUsage": {
    "text": "Nacho, an islander, here to help.",
    "source": "machine"
  },
  "char_4232_hbound.itemDesc": {
    "text": "He couldn't think of fancier words, but his desire to help is genuine.",
    "source": "machine"
  },
  "char_4234_pedro.itemUsage": {
    "text": "Pedro, a name so common it is always overlooked.",
    "source": "machine"
  },
  "char_4234_pedro.itemDesc": {
    "text": "He tries his best to understand those who go to their deaths, yet never expects anyone to understand him.",
    "source": "machine"
  },
  "char_4235_thumpy.potential.2.desc": {
    "text": "Max HP +270",
    "source": "machine"
  },
  "char_4235_thumpy.itemUsage": {
    "text": "Dreaming of becoming a trailblazer, Sanbi bravely took her first step.",
    "source": "machine"
  },
  "char_4235_thumpy.itemDesc": {
    "text": "Step by step, she will go see a more splendid land and achieve what she once thought impossible.",
    "source": "machine"
  },
  "char_4236_tmslot.itemUsage": {
    "text": "Communications engineer Amelia harbors the dream of connecting the entire land through communications.",
    "source": "machine"
  },
  "char_4236_tmslot.itemDesc": {
    "text": "Summoning all her courage, she reaffirmed her ideal and works hard to realize it.",
    "source": "machine"
  },
  "char_4237_jcinta.potential.2.desc": {
    "text": "DEF +23",
    "source": "machine"
  },
  "char_4237_jcinta.itemUsage": {
    "text": "Striving to live her life to the fullest, Jacinta never stops running forward.",
    "source": "machine"
  },
  "char_4237_jcinta.itemDesc": {
    "text": "She wants to go faster, even faster—fast enough, she hopes, to outrun time itself.",
    "source": "machine"
  }
