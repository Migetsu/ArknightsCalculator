  "stories": [
    {
      "storyTitle": {
        "en": "Profile",
        "zh": "客观履历",
        "source": "official",
        "isMachineTranslation": false
      },
      "text": {
        "en": "Castle-3 is a custom Raythean -Plus six-wheeled operations platform built by Closure. A likeable mascot for Rhodes Island, his mundane disposition means he is largely ignored. \nThe solid blocky appearance of Castle-3 gives off a trustworthy, dependable impression. \nThe marks on his casing may represent kills, but who made the marks if he has no hands?",
        "zh": "Castle-3是可露希尔客制化后的雷神存在者™Plus六轮作业平台。受人喜爱，也是吉祥物一般的存在不过因为性格比较正常所以没有获得那么多关注。\nCastle-3方方正正的形象给人以坚定可靠的感觉。\n身上的标记可能代表着杀敌数，但是他自己没有手，所以是谁刻上去的呢？",
        "source": "official",
        "isMachineTranslation": false
      },
      "unlockType": "DIRECT"
    },
    {
      "storyTitle": {
        "en": "Archive File 1",
        "zh": "档案资料一",
        "source": "official",
        "isMachineTranslation": false
      },
      "text": {
        "en": "He does not mind Closure's modifications, and is even quite pleased with the upgrade. His settings were changed to make Closure his favorite person, so he's satisfied with anything 'Master Closure' chooses to do.",
        "zh": "对可露希尔改造自己毫不在意，并且对自己被强化了感到高兴。被设置成了最喜欢的东西是可露希尔，对此没有什么评价，觉得主人怎么做都可以。",
        "source": "official",
        "isMachineTranslation": false
      },
      "unlockType": "FAVOR",
      "unlockParam": "100"
    }
  ]
