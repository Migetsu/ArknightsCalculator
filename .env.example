# Supabase Configuration
SUPABASE_URL=
SUPABASE_KEY=

# Machine translation (scripts/data/translate-with-gemini.ts)
# Free-tier key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used for machine translation. Default: gemini-3.8-flash.
# Measured on batch_001 (60 strings): gemini-3.8-flash produced 1 tag mismatch,
# gemini-3.5-flash-lite produced 19-20. gemini-4-argon is not available on the
# free tier (HTTP 429). See docs/i18n-machine-translation.md.
GEMINI_MODEL=gemini-3.8-flash
