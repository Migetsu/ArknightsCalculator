{
  "name": "arknights-calculator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:agent": "node scripts/dev-agent.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "node scripts/patch-vue.mjs && nuxt prepare",
    "prepare": "husky",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . && stylelint \"**/*.{scss,vue}\"",
    "lint:fix": "eslint --fix . && stylelint --fix \"**/*.{scss,vue}\"",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "lint:style": "stylelint \"**/*.{scss,vue}\"",
    "lint:style:fix": "stylelint --fix \"**/*.{scss,vue}\"",
    "stylelint": "stylelint \"**/*.{scss,vue}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "i18n:check": "node --experimental-strip-types scripts/check-i18n.ts",
    "data:pins": "jiti scripts/data/update-sources.ts",
    "data:fetch": "jiti scripts/data/fetch-raw.ts",
    "data:build": "jiti scripts/data/build-operators.ts",
    "data:assets": "jiti scripts/data/build-asset-manifest.ts",
    "data:verify-assets": "jiti scripts/data/verify-assets.ts",
    "data:constants": "jiti scripts/data/build-constants.ts",
    "data:items": "jiti scripts/data/build-items.ts",
    "data:recipes": "jiti scripts/data/build-recipes.ts",
    "data:recruit": "jiti scripts/data/build-recruit.ts",
    "data:skins": "jiti scripts/data/build-skins.ts",
    "data:wiki-banners": "jiti scripts/data/fetch-wiki-banners.ts",
    "data:banners": "jiti scripts/data/build-banners.ts",
    "data:validate": "jiti scripts/data/validate-data.ts",
    "data:thumbs": "jiti scripts/data/build-art-thumbs.ts",
    "data:banner-thumbs": "jiti scripts/data/build-banner-thumbs.ts",
    "data:stages": "jiti scripts/data/build-stages.ts",
    "data:ranges": "jiti scripts/data/build-ranges.ts",
    "data:handbook": "jiti scripts/data/build-handbook.ts",
    "data:inspect": "jiti scripts/data/inspect-operator.ts",
    "data:penguin": "jiti scripts/data/fetch-penguin.ts",
    "data:translate:check": "jiti scripts/data/translate-with-gemini.ts --check",
    "data:translate:dry": "jiti scripts/data/translate-with-gemini.ts --dry-run",
    "data:translate:run": "jiti scripts/data/translate-with-gemini.ts --run",
    "data:translate:all": "jiti scripts/data/translate-missing.ts --export 60 && jiti scripts/data/translate-with-gemini.ts --run --resume && jiti scripts/data/translate-missing.ts --import",
    "screenshots": "jiti scripts/take-screenshots.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@nuxt/icon": "^2.1.0",
    "@nuxt/image": "^2.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^8.6.1",
    "@nuxtjs/supabase": "^2.1.0",
    "@pinia/nuxt": "^1.0.2",
    "@vueuse/core": "^13.9.0",
    "@vueuse/nuxt": "^13.9.0",
    "nuxt": "^4.6.1",
    "nuxt-schema-org": "^6.4.3",
    "pinia": "^4.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.64.0",
    "@vue/test-utils": "^2.5.1",
    "crossws": "^0.4.15",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.93.3",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.1.5"
  }
}
